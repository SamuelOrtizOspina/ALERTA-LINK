# =============================================================
# ALERTA-LINK - Plantilla de configuracion del backend
#
# Copie este archivo como .env en la carpeta backend/ y complete
# los valores. El archivo .env NO debe subirse al repositorio.
#
#     cp backend/.env.example backend/.env
#
# El sistema funciona sin ninguna de estas variables: sin claves
# de API opera en modo offline (solo reglas locales) y sin
# DATABASE_URL usa archivos JSONL como respaldo.
# =============================================================

# --- Aplicacion ---------------------------------------------
# DEBUG=true muestra advertencias de configuracion al iniciar.
# En produccion debe quedar en false.
DEBUG=false

# Modo de conexion global: auto | online | offline
# auto: usa APIs externas solo si hay claves configuradas
CONNECTION_MODE=auto
OFFLINE_FALLBACK=true

# --- Seguridad ----------------------------------------------
# OBLIGATORIO en produccion. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Origenes permitidos, separados por coma.
# NUNCA usar "*" en produccion.
# El puerto 8080 corresponde a la app web de Flutter en local.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://10.0.2.2:8000

# --- Base de datos ------------------------------------------
# Si se deja vacio, los analisis y reportes se guardan en
# datasets/ingested/*.jsonl en lugar de PostgreSQL.
# Formato: postgresql://usuario:clave@host:5432/basededatos
DATABASE_URL=

# --- Tranco (ranking de dominios legitimos) ------------------
# Registro gratuito en https://tranco-list.eu/
# Sin estas claves no se activan las senales DOMAIN_IN_TRANCO
# ni DOMAIN_NOT_IN_TRANCO en modo online.
TRANCO_API_KEY=
TRANCO_API_EMAIL=
# Un dominio se considera legitimo solo dentro del top N.
# Umbral estricto para evitar que typosquats populares
# obtengan la bonificacion de confianza.
TRANCO_RANK_THRESHOLD=10000

# --- VirusTotal (reputacion de URLs) ------------------------
# Clave gratuita en https://www.virustotal.com/gui/my-apikey
# El tier gratuito permite 4 consultas por minuto.
VIRUSTOTAL_API_KEY=
# Minimo de motores que deben marcar la URL para considerarla maliciosa
VIRUSTOTAL_THRESHOLD=3
# Rango de score en el que se consulta VirusTotal (zona de incertidumbre)
VIRUSTOTAL_UNCERTAINTY_MIN=30
VIRUSTOTAL_UNCERTAINTY_MAX=70
