<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================== -->
    <!-- PERMISOS - Solo los estrictamente necesarios  -->
    <!-- ============================================== -->

    <!-- Internet: Para comunicarse con el backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS: Para detectar phishing automáticamente -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Notificaciones: Para alertar al usuario (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibración: Para alertas de alto riesgo -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="ALERTA-LINK"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ============================================== -->
        <!-- MainActivity: Punto de entrada de la app      -->
        <!-- ============================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Launcher: Icono en el home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Share Intent: Recibir URLs desde otras apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ============================================== -->
        <!-- SMS Receiver: Detecta SMS entrantes           -->
        <!-- ============================================== -->
        <!--
            IMPORTANTE: Este receiver NO es un servicio en segundo plano.
            Solo se activa cuando llega un SMS y se ejecuta brevemente (~10s).
            No consume batería cuando no hay SMS entrantes.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ============================================== -->
        <!-- Push Notification Listener (existente)        -->
        <!-- ============================================== -->
        <service
            android:name=".PushListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Flutter embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Permite abrir URLs en navegadores externos -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
